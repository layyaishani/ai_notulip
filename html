}
.cta:hover { transform: translateY(-2px); }
.cta.primary { background: linear-gradient(110deg, #3d5df6, #2844e3); border: 1px solid #3857f4; color: #ffffff; box-shadow: 0 10px 22px rgba(56, 87, 244, 0.3); }
.cta.secondary { background: rgba(255, 255, 255, 0.85); color: #1e293b; border: 1px solid #cbd5e1; }
.cta svg { width: 18px; height: 18px; }

/* Hero Sheet Visual Mockup */
.art { min-height: 410px; display: grid; place-items: center; position: relative; }
.glow { position: absolute; width: 380px; height: 380px; border-radius: 50%; background: linear-gradient(145deg, rgba(229, 228, 255, 0.7), rgba(214, 248, 255, 0.6)); }
.sheet {
  position: relative;
  width: min(100%, 430px);
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 18px;
  padding: 24px 26px;
  box-shadow: 0 25px 60px rgba(30, 41, 59, 0.12);
  transform: rotate(1deg);
}
.sheethead { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #f1f5f9; padding-bottom: 14px; margin-bottom: 16px; font-size: 11px; font-weight: 850; }
.minilogo { display: flex; align-items: center; gap: 7px; color: #0f172a; }
.minilogo .logo i { width: 3px; }
.minilogo .logo i:nth-child(1), .minilogo .logo i:nth-child(5) { height: 8px; }
.minilogo .logo i:nth-child(2), .minilogo .logo i:nth-child(4) { height: 14px; }
.minilogo .logo i:nth-child(3) { height: 20px; }
.chip { font-size: 9.5px; color: #2563eb; background: #eff6ff; border-radius: 6px; padding: 4px 8px; font-weight: 750; }
.doctitle { font-size: 19px; font-weight: 850; margin-bottom: 4px; color: #0f172a; }
.meta { font-size: 10.5px; color: #64748b; margin-bottom: 16px; }
.docrow { display: grid; grid-template-columns: 28px 1fr; gap: 10px; margin: 14px 0; }
.docicon { height: 28px; width: 28px; border-radius: 50%; display: grid; place-items: center; background: #eff6ff; color: #2563eb; }
.docicon svg { width: 15px; height: 15px; }
.docrow h4 { font-size: 11.5px; margin: 0 0 3px; color: #1e293b; font-weight: 800; }
.docrow p { font-size: 10.5px; line-height: 1.5; color: #475569; margin: 0; }
.task { display: flex; gap: 7px; margin: 6px 0; color: #475569; font-size: 10.5px; align-items: center; }
.check { width: 12px; height: 12px; border: 1.5px solid #94a3b8; border-radius: 3px; flex: none; display: grid; place-items: center; }
.check::after { content: "✓"; font-size: 9px; color: #2563eb; font-weight: 900; }
.sheetfoot { display: flex; justify-content: space-between; border-top: 1px solid #f1f5f9; margin-top: 16px; padding-top: 12px; color: #64748b; font-size: 9.5px; font-weight: 650; }
.floatnote { position: absolute; right: -5px; top: 40px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 10px 14px; box-shadow: 0 10px 25px rgba(0,0,0,0.08); font-size: 11px; font-weight: 750; transform: rotate(4deg); }
.floatnote span { color: var(--b); }
.audio { position: absolute; left: -5px; bottom: 15px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; box-shadow: 0 10px 25px rgba(0,0,0,0.08); padding: 10px 14px; display: flex; align-items: center; gap: 10px; }
.play { width: 28px; height: 28px; border-radius: 50%; background: linear-gradient(135deg, #8b5cf6, #5b42ef); display: grid; place-items: center; color: white; }
.play svg { width: 13px; height: 13px; }
.wave { height: 24px; display: flex; align-items: center; gap: 3px; }
.wave i { width: 3px; border-radius: 3px; background: linear-gradient(180deg, #9c7bff, #4f5ff5); }
.wave i:nth-child(3n+1) { height: 8px; }
.wave i:nth-child(3n+2) { height: 20px; }
.wave i:nth-child(3n) { height: 13px; }

/* Features Grid Section */
.features { padding: 50px clamp(20px, 6vw, 90px) 60px; text-align: center; background: #ffffff; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.sectiontitle { font-size: 30px; letter-spacing: -1px; margin: 0 0 8px; font-weight: 850; color: #0f172a; }
.subtitle { color: var(--muted); margin: 0 auto 38px; font-size: 15px; max-width: 620px; }
.featuregrid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; text-align: left; }
.fcard { display: block; background: var(--bg-page); border: 1px solid var(--line); border-radius: 18px; padding: 22px 18px; transition: all 0.2s; }
.fcard:hover, .fdetail:hover { border-color: #cbd5e1; transform: translateY(-3px); box-shadow: var(--shadow-sm); }
.ficon { width: 48px; height: 48px; border-radius: 12px; display: grid; place-items: center; margin-bottom: 16px; }
.ficon svg { width: 24px; height: 24px; }
.purple { color: #7c3aed; background: #f3e8ff; }
.blue { color: #2563eb; background: #eff6ff; }
.green { color: #0d9488; background: #ccfbf1; }
.orange { color: #ea580c; background: #ffedd5; }
.fcard h3, .fdetail h3 { margin: 0 0 8px; font-size: 15px; font-weight: 850; color: #0f172a; }
.fcard p, .fdetail p { margin: 0; font-size: 13px; color: #475569; line-height: 1.6; }
.learn { display: inline-block; color: var(--b); font-weight: 750; font-size: 12.5px; margin-top: 12px; }

/* Subpages Container */
.page { padding: 40px clamp(20px, 6vw, 90px) 60px; min-height: calc(100vh - 76px); background: linear-gradient(135deg, #f8fafc, #f1f5f9 65%, #edf4ff); }
.pagehead { text-align: center; max-width: 740px; margin: 0 auto 35px; }
.pagehead .eyebrow { margin-bottom: 12px; }
.pagehead h1 { font-size: clamp(30px, 3.8vw, 44px); letter-spacing: -1.2px; margin-bottom: 10px; }
.pagehead p { color: var(--muted); font-size: 15px; line-height: 1.65; margin: 0; }

.steps, .featurepage { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; max-width: 1100px; margin: auto; }
.step, .fdetail, .panel { background: #ffffff; border: 1px solid var(--line); border-radius: 18px; padding: 24px; box-shadow: var(--shadow-sm); }
.num { width: 34px; height: 34px; border-radius: 10px; background: #eff6ff; color: #2563eb; font-weight: 850; display: grid; place-items: center; margin-bottom: 14px; font-size: 13px; }
.visual { height: 160px; border-radius: 14px; background: linear-gradient(135deg, #f1f5f9, #eff6ff); display: grid; place-items: center; margin-bottom: 16px; border: 1px solid #e2e8f0; position: relative; overflow: hidden; }
.vcard { width: 84%; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); text-align: center; }
.vmic { width: 38px; height: 38px; display: grid; place-items: center; background: #eff6ff; border-radius: 50%; color: #2563eb; margin: 0 auto 6px; }
.vmic svg { width: 20px; height: 20px; }
.vline { height: 5px; background: #e2e8f0; border-radius: 8px; margin: 5px auto; width: 80%; }
.vline.short { width: 50%; }
.step small, .fdetail small { font-size: 10px; color: #2563eb; font-weight: 850; letter-spacing: 0.5px; }
.step h3 { font-size: 16px; margin: 6px 0 6px; color: #0f172a; }
.step p { font-size: 13px; line-height: 1.6; color: #475569; margin: 0; }
.featurepage { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.fdetail { display: flex; flex-direction: column; align-items: flex-start; }
.fdetail .ficon { margin-bottom: 14px; }
.fdetail p { flex: 1; margin-bottom: 12px; }

/* Editor & Workspace 2-Column Grid Layout */
.panelgrid { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: 24px; max-width: 1260px; margin: auto; align-items: start; }
.panel h2 { font-size: 19px; margin: 0 0 4px; display: flex; align-items: center; justify-content: space-between; color: #0f172a; }
.muted { color: var(--muted); font-size: 13px; line-height: 1.6; margin: 0 0 16px; }

.row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.row3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; }
.field { display: block; margin-bottom: 14px; }
.field label { display: block; font-size: 12px; font-weight: 750; margin-bottom: 5px; color: #334155; }
.field input, .field textarea, .field select {
  width: 100%;
  border: 1px solid #cbd5e1;
  border-radius: 10px;
  padding: 10px 12px;
  color: #0f172a;
  background: #ffffff;
  font-size: 13px;
  outline: none;
  transition: border-color 0.15s, box-shadow 0.15s;
}
.field textarea { resize: vertical; min-height: 110px; line-height: 1.6; }
.field input:focus, .field textarea:focus, .field select:focus {
  border-color: var(--b);
  box-shadow: 0 0 0 3px rgba(56, 87, 244, 0.15);
}
.field small { display: block; color: #64748b; font-size: 11px; line-height: 1.4; margin-top: 5px; }

.drop {
  border: 2px dashed #93c5fd;
  border-radius: 14px;
  padding: 18px 14px;
  text-align: center;
  background: #f8fafc;
  margin-bottom: 14px;
  transition: all 0.2s ease;
  position: relative;
  cursor: pointer;
}
.drop:hover, .drop.dragover { border-color: var(--b); background: #eff6ff; }
.drop svg { width: 28px; height: 28px; color: var(--b); margin-bottom: 4px; }
.drop p { font-size: 13px; color: #1e293b; margin: 2px 0; font-weight: 700; }
.drop small { color: #64748b; font-size: 11px; display: block; }
.drop input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }
.file-status {
  display: none;
  align-items: center;
  justify-content: space-between;
  background: #eff6ff;
  border: 1px solid #bfdbfe;
  padding: 10px 14px;
  border-radius: 10px;
  margin-bottom: 14px;
  font-size: 12px;
  font-weight: 700;
  color: #1d4ed8;
}
.file-status span { display: flex; align-items: center; gap: 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.remove-file { background: none; border: none; color: #ef4444; font-size: 16px; font-weight: 800; padding: 2px 6px; cursor: pointer; }

.sample-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f1f5f9;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  padding: 8px 12px;
  margin-bottom: 14px;
  font-size: 12px;
  color: #334155;
}
.sample-btn {
  background: #ffffff;
  border: 1px solid #cbd5e1;
  color: var(--b);
  padding: 5px 11px;
  border-radius: 7px;
  font-weight: 750;
  font-size: 11px;
  transition: all 0.15s;
}
.sample-btn:hover { background: var(--b); color: #ffffff; border-color: var(--b); }

.keyword { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 12px; margin: 4px 0 16px; }
.keyword label { color: #1e293b; }
.wide {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  border: 0;
  border-radius: 12px;
  padding: 13px;
  color: #ffffff;
  background: linear-gradient(110deg, #3d5df6, #2542e2);
  font-weight: 800;
  font-size: 13.5px;
  box-shadow: 0 8px 20px rgba(56, 87, 244, 0.25);
  transition: all 0.2s;
}
.wide:hover { transform: translateY(-1px); box-shadow: 0 12px 24px rgba(56, 87, 244, 0.35); }

/* Document Preview Wrap & Formal Minutes Paper */
.doc-preview-wrap {
  background: #e2e8f0;
  border: 1px solid #cbd5e1;
  border-radius: 14px;
  padding: 18px;
  max-height: 780px;
  overflow-y: auto;
}
.empty { text-align: center; padding: 60px 20px; background: #ffffff; border-radius: 10px; border: 1px dashed #cbd5e1; }
.empty .ficon { margin: 0 auto 12px; }
.empty strong { display: block; color: #1e293b; margin-bottom: 6px; font-size: 15px; }
.empty p { margin: 0; color: #64748b; font-size: 13px; }

/* Formal Minutes Document Paper (A4 Styled Layout) */
#notulen-paper {
  background: #ffffff;
  color: #0f172a;
  padding: 38px 42px;
  border-radius: 4px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.06);
  font-family: 'Segoe UI', Inter, Arial, sans-serif;
  line-height: 1.55;
  font-size: 12.5px;
  outline: none;
}
.doc-header { border-bottom: 2.5px solid #1e3a8a; padding-bottom: 14px; margin-bottom: 18px; display: flex; justify-content: space-between; align-items: flex-start; }
.doc-org { font-size: 11px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; color: var(--b); margin-bottom: 3px; }
.doc-main-title { font-size: 21px; font-weight: 850; color: #0f172a; margin: 0; letter-spacing: -0.4px; }
.doc-badge { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; font-size: 9.5px; font-weight: 800; padding: 4px 9px; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.5px; }

.meta-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 12px; }
.meta-table td { padding: 6px 10px; border: 1px solid #cbd5e1; vertical-align: top; }
.meta-label { width: 22%; background: #f8fafc; font-weight: 700; color: #334155; }
.meta-val { width: 28%; color: #0f172a; }

.sec-block { margin-bottom: 18px; page-break-inside: avoid; }
.sec-title { font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: #1e3a8a; border-bottom: 1px solid #cbd5e1; padding-bottom: 5px; margin: 0 0 10px; display: flex; align-items: center; gap: 6px; }
.sec-body { color: #1e293b; text-align: justify; }
.sec-list { margin: 0; padding-left: 18px; }
.sec-list li { margin-bottom: 6px; padding-left: 2px; }

.action-table { width: 100%; border-collapse: collapse; font-size: 11.5px; margin-top: 6px; }
.action-table th { background: #1e3a8a; color: #ffffff; font-weight: 700; text-align: left; padding: 7px 9px; border: 1px solid #1e3a8a; }
.action-table td { padding: 7px 9px; border: 1px solid #cbd5e1; vertical-align: top; color: #1e293b; }
.action-table tr:nth-child(even) td { background: #f8fafc; }
.status-pill { display: inline-block; padding: 2px 7px; border-radius: 4px; font-size: 10px; font-weight: 700; background: #fef3c7; color: #92400e; }

.doc-footer { margin-top: 28px; padding-top: 14px; border-top: 1px solid #cbd5e1; display: flex; justify-content: space-between; font-size: 11px; color: #64748b; page-break-inside: avoid; }
.sign-box { text-align: center; width: 190px; }
.sign-line { margin-top: 45px; border-top: 1px solid #334155; padding-top: 4px; font-weight: 700; color: #0f172a; }

.resultbuttons { display: grid; grid-template-columns: 1.3fr 1fr 1fr 1fr; gap: 8px; margin-top: 14px; }
.resultbuttons button { border: 1px solid #cbd5e1; border-radius: 10px; padding: 10px 8px; background: #ffffff; color: #1e293b; font-size: 12px; font-weight: 750; display: flex; align-items: center; justify-content: center; gap: 6px; transition: all 0.15s; }
.resultbuttons button:hover { background: #f1f5f9; border-color: #94a3b8; }
.resultbuttons button.btn-pdf { background: linear-gradient(135deg, #e11d48, #be123c); color: #ffffff; border-color: #be123c; box-shadow: 0 4px 14px rgba(225,29,72,0.22); }
.resultbuttons button.btn-pdf:hover { background: linear-gradient(135deg, #be123c, #9f1239); transform: translateY(-1px); }

/* Toast Notification Floating Alert */
.toast {
  position: fixed;
  bottom: 24px; left: 50%;
  transform: translate(-50%, 20px);
  opacity: 0; pointer-events: none;
  background: #0f172a; color: #ffffff;
  padding: 11px 20px; border-radius: 12px;
  font-size: 13px; font-weight: 600;
  transition: all 0.25s ease;
  z-index: 1000; max-width: 90%;
  text-align: center; box-shadow: 0 10px 25px rgba(0,0,0,0.2);
}
.toast.show { opacity: 1; transform: translate(-50%, 0); }

/* Dark Theme Support */
body.dark { background: #0f172a; color: #f8fafc; --bg-page: #0f172a; --bg-panel: #1e293b; --line: #334155; --muted: #94a3b8; }
