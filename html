<style>
/* CSS Design Tokens & Reset */
:root {
  --b: #3857f4;
  --b-hover: #2745d8;
  --p: #7954f6;
  --ink: #0f172a;
  --muted: #64748b;
  --line: #e2e8f0;
  --bg-page: #f8fafc;
  --bg-panel: #ffffff;
  --shadow-sm: 0 4px 12px rgba(0,0,0,0.04);
  --shadow-lg: 0 20px 45px rgba(56,87,244,0.12);
}

* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  color: var(--ink);
  background: var(--bg-page);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration: none; }
button, input, textarea, select { font: inherit; cursor: pointer; }

/* Sticky Top Navigation Bar */
.top {
  height: 76px;
  display: flex;
  align-items: center;
  gap: 28px;
  padding: 0 clamp(20px, 6vw, 90px);
  position: sticky;
  top: 0;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--line);
  z-index: 100;
}
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 19px;
  font-weight: 850;
  letter-spacing: -0.4px;
  color: var(--ink);
}
.logo { display: flex; align-items: center; gap: 3px; }
.logo i { display: block; width: 4.5px; border-radius: 4px; background: linear-gradient(180deg, #8b65ff, #3155f5); }
.logo i:nth-child(1), .logo i:nth-child(5) { height: 12px; }
.logo i:nth-child(2), .logo i:nth-child(4) { height: 22px; }
.logo i:nth-child(3) { height: 32px; }

.nav {
  display: flex;
  gap: 24px;
  margin-left: auto;
  height: 100%;
  align-items: center;
}
.nav a {
  height: 100%;
  display: flex;
  align-items: center;
  position: relative;
  font-size: 13px;
  font-weight: 700;
  color: #475569;
  transition: color 0.15s;
}
.nav a:hover { color: var(--b); }
.nav a.active { color: var(--b); }
.nav a.active::after {
  content: "";
  position: absolute;
  bottom: 14px;
  left: 0; right: 0;
  height: 2.5px;
  border-radius: 2px;
  background: var(--b);
}

.actions { display: flex; gap: 10px; align-items: center; }
.iconbtn, .outline, .solid {
  border-radius: 12px;
  padding: 9px 16px;
  font-size: 13px;
  font-weight: 750;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  transition: all 0.2s ease;
}
.iconbtn { border: 1px solid var(--line); background: #ffffff; color: #475569; font-size: 15px; padding: 9px 12px; }
.iconbtn:hover { background: #f1f5f9; }
.outline { border: 1px solid #cbd5e1; background: #ffffff; color: #1e293b; }
.outline:hover { border-color: var(--b); color: var(--b); transform: translateY(-1px); }
.solid { border: 1px solid var(--b); background: linear-gradient(135deg, #3d5df6, #304ce7); color: #ffffff; box-shadow: 0 6px 16px rgba(56, 87, 244, 0.25); }
.solid:hover { transform: translateY(-1.5px); box-shadow: 0 10px 22px rgba(56, 87, 244, 0.35); }

main { min-height: calc(100vh - 76px); }

/* Landing Page Hero Section */
.hero {
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  gap: 40px;
  align-items: center;
  padding: 60px clamp(20px, 6vw, 90px) 50px;
  min-height: 560px;
  background: radial-gradient(ellipse at 70% 30%, rgba(212, 206, 255, 0.45), transparent 50%),
              radial-gradient(ellipse at 95% 80%, rgba(191, 241, 255, 0.5), transparent 40%),
              linear-gradient(115deg, #f8fafc, #f1f5f9 60%, #eff6ff);
