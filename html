// Render generated minutes into right side preview panel
function renderDocumentToPreview(m) {
  currentNotulen = m;
  const emptyEl = document.getElementById('empty-state');
  const contEl = document.getElementById('notulen-container');
  const badgeEl = document.getElementById('edit-badge');
  if (!contEl) return;
  emptyEl.style.display = 'none';
  contEl.style.display = 'block';
  contEl.innerHTML = buildDocumentHTML(m);
  if (badgeEl) badgeEl.style.display = 'inline-block';
}

// SPA View Router
function render(route) {
  let html;
  if (route === 'beranda') html = homeView();
  else if (route === 'fitur') html = featurePageView();
  else if (route === 'cara-kerja') html = howView();
  else if (route === 'buat-notulen') html = createView();
  else if (route === 'riwayat') html = historyView();
  else if (route.startsWith('fitur/')) html = featureDetailView(route.split('/')[1]);
  else html = homeView();

  app.innerHTML = html;

  // Bind route links
  document.querySelectorAll('[data-route]').forEach(el => el.addEventListener('click', e => {
    e.preventDefault();
    location.hash = el.dataset.route;
  }));

  // Bind history view actions
  document.querySelectorAll('[data-open]').forEach(el => el.addEventListener('click', () => {
    const idx = +el.dataset.open;
    const item = saved[idx];
    if (!item) return;
    currentNotulen = item;
    location.hash = 'buat-notulen';
  }));

  document.querySelectorAll('[data-del]').forEach(el => el.addEventListener('click', () => {
    const idx = +el.dataset.del;
    saved.splice(idx, 1);
    localStorage.setItem('ai_notulen_history', JSON.stringify(saved));
    updateNavBadge();
    toast('Riwayat notulen berhasil dihapus.');
    render('riwayat');
  }));

  // Update active nav class
  document.querySelectorAll('.nav a').forEach(a => a.classList.toggle(
    'active',
    a.dataset.route === route || (route.startsWith('fitur/') && a.dataset.route === 'fitur')
  ));

  if (route === 'buat-notulen') {
    bindCreateEvents();
    if (currentNotulen) {
      renderDocumentToPreview(currentNotulen);
    }
  }
}

// Workspace Event Binding (File Drag & Drop, Sample Data, PDF Export, LocalStorage)
function bindCreateEvents() {
  const fileInput = document.querySelector('#audio'),
        dropzone = document.querySelector('#dropzone'),
        statusBox = document.querySelector('#filestatus'),
        fileNameSpan = document.querySelector('#filename'),
        removeBtn = document.querySelector('#removefile');

  function handleFile(f) {
    if (!f) return;
    selectedFile = f;
    fileNameSpan.textContent = `${f.name} (${(f.size / (1024 * 1024)).toFixed(2)} MB)`;
    statusBox.style.display = 'flex';

    // Auto-read plain text files into transcript textarea
    if (f.name.toLowerCase().endsWith('.txt') || f.type === 'text/plain') {
      const reader = new FileReader();
      reader.onload = (ev) => {
        document.querySelector('#transcript').value = ev.target.result;
        toast(`File teks "${f.name}" berhasil dimuat ke transkrip!`);
      };
      reader.readAsText(f);
    } else {
      toast(`File rekaman "${f.name}" berhasil diunggah.`);
    }
  }

  removeBtn.addEventListener('click', () => {
    selectedFile = null;
    fileInput.value = '';
    statusBox.style.display = 'none';
  });

  fileInput.addEventListener('change', () => handleFile(fileInput.files[0]));

  ['dragenter', 'dragover'].forEach(eName => {
    dropzone.addEventListener(eName, e => { e.preventDefault(); e.stopPropagation(); dropzone.classList.add('dragover'); }, false);
  });
  ['dragleave', 'drop'].forEach(eName => {
    dropzone.addEventListener(eName, e => { e.preventDefault(); e.stopPropagation(); dropzone.classList.remove('dragover'); }, false);
  });
  dropzone.addEventListener('drop', e => {
    const files = e.dataTransfer.files;
    if (files && files.length > 0) {
      fileInput.files = files;
      handleFile(files[0]);
    }
  });

  // Quick sample text population
  document.querySelector('#fill-sample').addEventListener('click', () => {
    document.querySelector('#org').value = 'PT Nusantara Digital';
    document.querySelector('#title').value = 'Rapat Koordinasi Peluncuran Aplikasi v2.0 & Evaluasi Q4';
    document.querySelector('#mtime').value = '09.30 - 11.30 WIB';
    document.querySelector('#mloc').value = 'Ruang Rapat Utama & Zoom Meeting';
    document.querySelector('#leader').value = 'Bapak Hendra Wijaya';
    document.querySelector('#notulis').value = 'Sdri. Nadya Putri';
    document.querySelector('#participants').value = 'Bapak Hendra Wijaya, Ibu Rina Kartika, Sdr. Dimas Pratama, Sdri. Nadya Putri, Tim Pemasaran';
    document.querySelector('#transcript').value = `Rapat dibuka oleh Bapak Hendra Wijaya pada pukul 09.30 WIB untuk membahas kesiapan peluncuran aplikasi versi 2.0.
Tim teknis melaporkan bahwa pengujian sistem utama telah mencapai 95% dan bebas dari kendala kritis.
Ibu Rina Kartika menyampaikan bahwa materi kampanye digital dan siaran pers sudah siap dipublikasikan.
Setelah berdiskusi mengenai kesiapan seluruh divisi, disepakati bahwa peluncuran resmi aplikasi akan dilaksanakan pada hari Senin depan.
Diputuskan pula bahwa anggaran promosi media sosial ditambah sebesar 15% untuk dua minggu pertama peluncuran.
Sdr. Dimas Pratama akan menyelesaikan finalisasi server produksi dan uji beban sebelum hari Jumat.
Tim Pemasaran bertanggung jawab menyiapkan materi video teaser dan jadwal unggahan paling lambat hari Kamis.
Sdri. Nadya Putri akan mengirimkan undangan resmi kepada mitra media pada hari Rabu.`;
    document.querySelector('#keywords').value = 'Aplikasi v2.0 = Platform Layanan Pelanggan Terpadu.\nPIC Teknis: Sdr. Dimas Pratama.';
    toast('Contoh data rapat dimuat! Klik "Susun Dokumen Notulen".');
  });

  // Generate minutes action
  document.querySelector('#generate').addEventListener('click', () => {
    const transcriptVal = document.querySelector('#transcript').value.trim();
    const titleVal = document.querySelector('#title').value.trim();

    if (!transcriptVal && !selectedFile) {
      toast('Tempelkan transkrip percakapan atau unggah file terlebih dahulu.');
      document.querySelector('#transcript').focus();
      return;
    }

    const effectiveTranscript = transcriptVal ||
      `Rapat membahas agenda "${titleVal || 'Koordinasi Tim'}" berdasarkan file rekaman ${selectedFile.name}. ` +
      `Seluruh peserta mengevaluasi pencapaian kerja serta membahas langkah taktis penyelesaian kendala. ` +
      `Disepakati bahwa pelaksana tugas mengumpulkan laporan akhir sebelum hari Jumat.`;

    const rawData = {
      org: document.querySelector('#org').value.trim() || 'NOTULENSI RAPAT',
      title: titleVal || (selectedFile ? selectedFile.name.replace(/\.[^/.]+$/, "") : 'Rapat Koordinasi'),
      mdate: document.querySelector('#mdate').value,
      mtime: document.querySelector('#mtime').value.trim() || '09.30 - selesai WIB',
      mloc: document.querySelector('#mloc').value.trim() || 'Ruang Rapat',
      leader: document.querySelector('#leader').value.trim(),
      notulis: document.querySelector('#notulis').value.trim(),
      participants: document.querySelector('#participants').value.trim(),
      transcript: effectiveTranscript,
      keywords: document.querySelector('#keywords').value.trim(),
      fileName: selectedFile ? selectedFile.name : ''
    };

    const structured = parseTranscriptToMinutes(rawData);
    renderDocumentToPreview(structured);
    toast('Dokumen notulen berhasil disusun! Anda dapat mengedit teks atau langsung unduh PDF.');
  });

  // Export PDF Action using html2pdf.js
  document.querySelector('#download-pdf').addEventListener('click', async () => {
    const paper = document.getElementById('notulen-paper');
    if (!paper || !currentNotulen) {
      toast('Susun dokumen notulen terlebih dahulu.');
      return;
    }

    const btn = document.querySelector('#download-pdf');
    const origHTML = btn.innerHTML;
    btn.innerHTML = 'Memproses PDF...';
    btn.disabled = true;

    const cleanTitle = (currentNotulen.title || 'Notulen_Rapat')
      .replace(/[^a-zA-Z0-9\s-_]/g, '')
      .trim()
      .replace(/\s+/g, '_');
    const filename = `Notulen_${cleanTitle}.pdf`;

    const opt = {
      margin:       [12, 12, 12, 12],
      filename:     filename,
      image:        { type: 'jpeg', quality: 0.98 },
      html2canvas:  { scale: 2, useCORS: true, letterRendering: true, scrollY: 0 },
      jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' },
      pagebreak:    { mode: ['avoid-all', 'css', 'legacy'] }
    };

    try {
      await html2pdf().set(opt).from(paper).save();
      toast(`Dokumen PDF "${filename}" berhasil diunduh!`);
    } catch (err) {
      console.error(err);
      toast('Membuka jendela cetak alternatif...');
      window.print();
    } finally {
      btn.innerHTML = origHTML;
      btn.disabled = false;
    }
  });

  // Copy Clean Text Action
  document.querySelector('#copy').addEventListener('click', async () => {
    const paper = document.getElementById('notulen-paper');
    if (!paper) return toast('Susun notulen terlebih dahulu.');
    try {
      await navigator.clipboard.writeText(paper.innerText);
      toast('Teks notulen berhasil disalin ke clipboard.');
    } catch {
      toast('Gagal menyalin teks.');
    }
  });

  // Save to LocalStorage History Action
  document.querySelector('#save').addEventListener('click', () => {
    if (!currentNotulen) return toast('Susun notulen terlebih dahulu.');
    const record = {
      ...currentNotulen,
      savedAt: new Date().toLocaleString('id-ID', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })
    };
    saved.unshift(record);
    localStorage.setItem('ai_notulen_history', JSON.stringify(saved));
    updateNavBadge();
    toast('Dokumen notulen berhasil disimpan ke Riwayat.');
  });

  // Print Window Action
  document.querySelector('#print').addEventListener('click', () => {
    const paper = document.getElementById('notulen-paper');
    if (!paper) return toast('Susun notulen terlebih dahulu.');
    const w = window.open('', '_blank');
    if (!w) return toast('Izinkan pop-up browser untuk mencetak.');
    const styles = document.querySelector('style').innerHTML;
    w.document.write(`<!doctype html><html><head><meta charset="utf-8"><title>${esc(currentNotulen.title)}</title><style>${styles} body{background:#fff;padding:0;margin:0} #notulen-paper{box-shadow:none;padding:15mm}</style></head><body>${paper.outerHTML}<script>window.onload=()=>{window.print();}<\/script></body></html>`);
    w.document.close();
  });
}

// Toast Helper
let toastTimer;
function toast(msg) {
  const el = document.querySelector('#toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove('show'), 3200);
}

