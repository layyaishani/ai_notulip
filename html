}
.hero-copy p { color: #475569; font-size: 16.5px; line-height: 1.65; max-width: 560px; margin: 0 0 32px; }
.buttons { display: flex; gap: 14px; flex-wrap: wrap; }
.cta {
  min-height: 52px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  border-radius: 999px;
  padding: 0 26px;
  font-weight: 750;
  font-size: 13.5px;
