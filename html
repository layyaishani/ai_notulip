// Date Formatter (Indonesian Format)
function formatIndoDate(dateStr) {
  if (!dateStr) return new Date().toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  const d = new Date(dateStr + 'T00:00:00');
  if (isNaN(d)) return dateStr;
  return d.toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
}

// Transcript Parsing Logic: Extracts Summaries, Discussion Points, Decisions & Action Items
function parseTranscriptToMinutes(data) {
  const raw = data.transcript.trim();
  const sentences = raw
    .split(/(?<=[.!?])\s+|\n+/)
    .map(s => s.replace(/^[-•*]\s*/, '').trim())
    .filter(s => s.length > 4);

  // 1. Executive Summary (First 2-3 sentences)
  const summaryLines = sentences.slice(0, Math.min(3, sentences.length));
  const summary = summaryLines.join(' ') + (summaryLines.length && !/[.!?]$/.test(summaryLines[summaryLines.length-1]) ? '.' : '');

  // 2. Decision Extraction
  const decisionKeywords = /(disepakati|diputuskan|setuju|menyetujui|ditetapkan|keputusan|final|sepakat|resmi|mengesahkan)/i;
  let decisions = sentences.filter(s => decisionKeywords.test(s));
  if (decisions.length === 0 && sentences.length > 2) {
    decisions = [sentences[Math.floor(sentences.length / 2)]];
  } else if (decisions.length === 0) {
    decisions = ['Seluruh peserta menyetujui poin pembahasan yang disampaikan dalam rapat.'];
  }

  // 3. Action Items Extraction
  const actionKeywords = /(akan|tugas|tindak lanjut|pic|bertanggung jawab|menyiapkan|menyelesaikan|mengumpulkan|membuat|deadline|tenggat|sebelum|paling lambat|koordinasi|follow up)/i;
  let actionSentences = sentences.filter(s => actionKeywords.test(s) && !decisions.includes(s));
  if (actionSentences.length === 0) {
    actionSentences = sentences.slice(-2);
  }

  const actions = actionSentences.slice(0, 6).map((s, idx) => {
    let pic = 'Tim Terkait';
    const picMatch = s.match(/(Pak|Bu|Bapak|Ibu|Sdr\.?|Sdri\.?|Divisi|Tim|Bagian|Ketua|Sekretaris|Bendahara)\s+[A-Z][a-zA-Z]+(?:\s+[A-Z][a-zA-Z]+)?/);
    if (picMatch) pic = picMatch[0];

    let deadline = 'Sesuai jadwal';
    const timeMatch = s.match(/(hari\s+(?:Senin|Selasa|Rabu|Kamis|Jumat|Sabtu|Minggu)|besok|minggu\s+ini|minggu\s+depan|bulan\s+ini|tanggal\s+\d+\s+[A-Za-z]+|\d+\s+[A-Za-z]+\s+\d{4})/i);
    if (timeMatch) deadline = timeMatch[0].charAt(0).toUpperCase() + timeMatch[0].slice(1);

    return {
      no: idx + 1,
      task: s.endsWith('.') ? s : s + '.',
      pic: pic,
      deadline: deadline,
      status: 'Dalam Proses'
    };
  });

  // 4. Main Discussion Points
  let discussions = sentences.filter(s => !decisions.includes(s)).slice(0, 6);
  if (discussions.length === 0) discussions = sentences.slice(0, 5);

  return {
    ...data,
    mdateFormatted: formatIndoDate(data.mdate),
    summary,
    discussions: discussions.map(d => d.endsWith('.') ? d : d + '.'),
    decisions: decisions.map(d => d.endsWith('.') ? d : d + '.'),
    actions
  };
}

